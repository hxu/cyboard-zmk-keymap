#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &physical_layout_imprint_function_row_full_bottom_row; };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            label = "Qwerty";
            bindings = <
&kp ESC    &kp F1  &kp F2    &kp F3    &kp F4    &kp F5              &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4    &kp N5              &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W     &kp E     &kp R     &kp T               &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A   &kp S     &kp D     &kp F     &kp G               &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V     &kp B               &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LALT  &kp DOWN  &kp UP  &none                         &kp EQUAL  &kp LEFT  &kp RIGHT  &kp LBKT  &kp RBKT
                                       &kp RET   &kp DEL  &none     &kp HOME  &kp BSPC  &kp SPACE
                                       &kp LGUI  &to 1    &bt BT_NXT  &kp END   &mkp LCLK  &mkp RCLK
            >;
        };

        colemak_dh {
            label = "Colemak-DH";
            bindings = <
&kp ESC    &kp F1  &kp F2    &kp F3    &kp F4    &kp F5              &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4    &kp N5              &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W     &kp F     &kp P     &kp B               &kp J      &kp L     &kp U      &kp Y     &kp SEMI  &kp BSLH
&kp CAPS   &kp A   &kp R     &kp S     &kp T     &kp G               &kp M      &kp N     &kp E      &kp I     &kp O     &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp D     &kp V               &kp K      &kp H     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LALT  &kp DOWN  &kp UP  &none                         &kp EQUAL  &kp LEFT  &kp RIGHT  &kp LBKT  &kp RBKT
                                       &kp RET   &kp DEL  &none     &kp HOME  &kp BSPC  &kp SPACE
                                       &kp LGUI  &to 2    &bt BT_NXT  &kp END   &mkp LCLK  &mkp RCLK
            >;
        };

        custom {
            label = "Custom";
            bindings = <
&kp ESC    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5              &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5              &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &kp MINUS
&kp TAB    &none   &none   &none   &none   &none               &none   &none   &none   &none   &none    &kp BSLH
&kp CAPS   &none   &none   &none   &none   &none               &none   &none   &none   &none   &kp SEMI &kp SQT
&kp LSHFT  &none   &none   &none   &none   &none               &none   &none   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LALT  &kp DOWN  &kp UP  &none                   &kp EQUAL  &kp LEFT  &kp RIGHT  &kp LBKT  &kp RBKT
                                  &kp RET   &kp DEL  &none     &kp HOME  &kp BSPC  &kp SPACE
                                  &kp LGUI  &to 0    &bt BT_NXT  &kp END   &mkp LCLK  &mkp RCLK
            >;
        };
    };
};

// Keep left-trackball scrolling, at half the previous sensitivity (1/6 -> 1/12).
&trackball_central_listener {
    input-processors =
        <&zip_xy_scaler 1 12>,
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
